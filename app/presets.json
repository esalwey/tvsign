{
  "presets": [
    {
      "id": "nuviotv",
      "name": "NuvioTV",
      "repo": "esalwey/NuvioTV",
      "asset": "NuvioTV.ipa",
      "channels": {
        "stable": {
          "tag_prefixes": ["tvos-v"],
          "prereleases": false
        },
        "beta": {
          "tag_prefixes": ["tvos-v", "custom-"],
          "prereleases": true
        }
      },
      "default_channel": "stable",
      "description": {
        "en": "Nuvio, made for Apple TV. Builds from github.com/esalwey/NuvioTV.",
        "fr": "Nuvio pour Apple TV. Builds publiées sur github.com/esalwey/NuvioTV."
      }
    }
  ]
}
